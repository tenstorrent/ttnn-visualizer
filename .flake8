[flake8]
ignore = E203, E266, E501, W503, F403, F401
exclude =
    .git,
    __pycache__,
    docs/source/conf.py,
    build,
    dist
max-complexity = 10
# Black owns line length (pyproject.toml [tool.black] line-length). Kept in
# sync so a standalone flake8 or pre-commit run agrees with the formatter;
# E501 stays ignored above for the strings and comments black cannot split.
max-line-length = 88
