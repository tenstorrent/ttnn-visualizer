# Optional overrides for local `.env`
#
# SPA config has two consumers:
#   pnpm dev              → only `VITE_*` reach the browser (`import.meta.env`)
#   Flask serves the SPA  → unprefixed vars from settings → `window.TTNN_VISUALIZER_CONFIG`
# Unprefixed SSH_* dialog defaults are browser-visible via Flask (local install);
# they are omitted from the SPA config when SERVER_MODE=true.

# ---------------------------------------------------------------------------
# Flask / backend
# ---------------------------------------------------------------------------
# FLASK_ENV=development
# HOST=localhost
# PORT=8000
# LAUNCH_BROWSER_ON_START=true
# SERVER_MODE=false
# BASE_PATH=/
# Usage events are appended to ~/.ttnn-visualizer/usage/events.log. Written on this
# machine only; the application transmits nothing. Recording is on by default.
# Switch it off with USAGE_RECORDING_DISABLED=true, or by creating
# ~/.ttnn-visualizer/usage/disabled (an env var is per-shell). Shown below at its
# default, so uncommenting the line as it stands keeps recording on.
# The one boolean here that obeys a value it doesn't recognise: because this is an
# opt-out, anything other than false/0 switches recording off rather than being ignored.
# USAGE_RECORDING_DISABLED=false

# Paths (when unset, APP_/REPORT_DATA_DIRECTORY are derived from TT_METAL_HOME)
# TT_METAL_HOME=
# APP_DATA_DIRECTORY=
# REPORT_DATA_DIRECTORY=

# Two separate knobs, despite the names. FLASK_DEBUG sets the DEBUG config value
# (Flask's own debug mode); DEBUG raises the root log level to DEBUG and is what
# `pnpm flask:start-debug` sets.
# FLASK_DEBUG=false
# DEBUG=false
# USE_WEBSOCKETS=true
# Defaults to http://localhost:<PORT>, plus the Vite dev server when FLASK_ENV is not
# production. Setting this replaces both. A binding this list doesn't name still serves
# the SPA — same-origin requests need no CORS header — but reaching the app under a
# proxied hostname does need it listed here, because the socket handshake refuses an
# unlisted Origin outright.
# ALLOWED_ORIGINS=http://localhost:8000
# Report paths kept in the signed session cookie, oldest dropped first. Must be 1 or
# more: the cap is applied as a negative slice, so 0 would mean no cap at all and let
# the cookie grow past the browser's size limit. An unusable value is reported and
# the default kept.
# SESSION_MAX_UPLOADED_REPORTS=10
# GUNICORN_WORKERS=1
# GUNICORN_TIMEOUT=60
# GUNICORN_WORKER_CLASS=gevent
# GUNICORN_APP_MODULE=ttnn_visualizer.app:create_app()
# SECRET_KEY=90909
# MAX_CONTENT_LENGTH=

# Flask-only: browser open target when FLASK_ENV is not production.
# Does not configure the Vite dev server (default port 5173).
# DEV_SERVER_HOST=localhost
# DEV_SERVER_PORT=5173

# ---------------------------------------------------------------------------
# Vite (`pnpm dev`) — VITE_ prefix required for the browser to see these
# ---------------------------------------------------------------------------
# VITE_SERVER_MODE=false
# VITE_USERNAME=
# VITE_TT_METAL_HOME=
# VITE_REPORT_DATA_DIRECTORY=
# Usage recording under `pnpm dev`. Off unless set, unlike the backend's on-by-default:
# a developer clicking through their own checkout is not usage, and defaulting on would
# write it into their real events.log. Set it to exercise /api/usage locally.
# VITE_USAGE_RECORDING_ACTIVE=false

# ---------------------------------------------------------------------------
# SSH — remote / MLIR connection dialog defaults + remote-op timeouts
# ---------------------------------------------------------------------------
# Dialog prefills (code default port is 22; TT boxes often use 45985).
# Report paths must be absolute — a `~`-relative path is not expanded on the remote host and
# the connection dialog refuses it:
# SSH_DEFAULT_PORT=22
# SSH_DEFAULT_PROFILER_PATH=/home/username/tt-metal/generated/ttnn/reports/
# SSH_DEFAULT_PERFORMANCE_PATH=/home/username/tt-metal/generated/profiler/reports/
# VITE_SSH_DEFAULT_PORT=22
# VITE_SSH_DEFAULT_PROFILER_PATH=
# VITE_SSH_DEFAULT_PERFORMANCE_PATH=

# Backend SFTP/SSH subprocess limits (seconds; defaults 120 / 45):
# SSH_SUBPROCESS_TIMEOUT=120
# SSH_REMOTE_CHECK_TIMEOUT=45
