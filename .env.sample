# SPA config has two consumers:
#   pnpm dev              → only `VITE_*` reach the browser (`import.meta.env`)
#   Flask serves the SPA  → unprefixed vars from settings → `window.TTNN_VISUALIZER_CONFIG`

# ---------------------------------------------------------------------------
# Flask / backend
# ---------------------------------------------------------------------------
FLASK_ENV=development
HOST=localhost
PORT=8000
LAUNCH_BROWSER_ON_START=true
SERVER_MODE=false
BASE_PATH=/

# Optional paths (defaults derived from TT_METAL_HOME when unset — see settings.py)
# TT_METAL_HOME=
# APP_DATA_DIRECTORY=
# REPORT_DATA_DIRECTORY=

# Optional Flask knobs
# FLASK_DEBUG=false
# USE_WEBSOCKETS=true
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# SESSION_MAX_UPLOADED_REPORTS=10
# GUNICORN_WORKERS=1
# GUNICORN_TIMEOUT=60
# GUNICORN_WORKER_CLASS=gevent
# GUNICORN_APP_MODULE=ttnn_visualizer.app:create_app()
# SECRET_KEY=90909
# MAX_CONTENT_LENGTH=

# Flask-only: host/port used when opening a browser for non-production FLASK_ENV.
# Does not configure the Vite dev server (always its own port, default 5173).
# DEV_SERVER_HOST=localhost
# DEV_SERVER_PORT=5173

# ---------------------------------------------------------------------------
# Vite (`pnpm dev`) — must use the VITE_ prefix
# ---------------------------------------------------------------------------
# VITE_SERVER_MODE=1
# VITE_USERNAME=
# VITE_TT_METAL_HOME=
# VITE_REPORT_DATA_DIRECTORY=

# ---------------------------------------------------------------------------
# SSH — remote / MLIR connection dialog defaults + remote-op timeouts
# ---------------------------------------------------------------------------
# Unprefixed vars are injected into the browser via Flask (local install only;
# suppressed when SERVER_MODE=true). VITE_* is for `pnpm dev` only.
# Defaults for "Add connection" / MLIR server dialogs (port often 45985 on TT boxes).
SSH_DEFAULT_PORT=22
# Memory / performance report roots, e.g.:
#   .../tt-metal/generated/ttnn/reports/
#   .../tt-metal/generated/profiler/reports/
SSH_DEFAULT_PROFILER_PATH=
SSH_DEFAULT_PERFORMANCE_PATH=

VITE_SSH_DEFAULT_PORT=22
VITE_SSH_DEFAULT_PROFILER_PATH=
VITE_SSH_DEFAULT_PERFORMANCE_PATH=

# Seconds — backend SFTP/SSH subprocess limits
SSH_SUBPROCESS_TIMEOUT=120
SSH_REMOTE_CHECK_TIMEOUT=45
